direction: right

vars: {
  d2-config: {
    theme-id: 3
    dark-theme-id: 200
  }
}

caller: Caller {
  shape: person
}

floop: floop

worker: "Worker agent\n(Codex, Claude, or local)"

caller -> floop: task + criteria
floop -> worker: work or correction
worker -> floop: result + evidence
floop -> caller: complete or blocker
